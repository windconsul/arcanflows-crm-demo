# Seeds for the FIRST boot only. After that the CRM admin page (/admin) owns the
# workspace settings (data/settings.json) and the CRM users (data/users.json).
# NEVER commit the real file. Keys stay on this server; the browser only ever gets 15-minute session tokens.

# --- the ArcanFlows workspace this CRM talks to (create both keys on that workspace's Phone System → Integrations page)
PBX=pbx_...            # embed key: mints sessions. Allowed origins must include CRM_ORIGIN.
PBXS=pbxs_...          # server key with scopes: calls:read stats:read presence:read extensions:read recordings:read calls:originate webhooks:manage seats:provision
WEBHOOK_SECRET=change-me       # the secret you put on the phone.* webhook subscriptions
LOOKUP_SECRET=change-me        # the secret you put on the caller-lookup setting
CRM_ORIGIN=crm.example.com     # host of this page, as seen by browsers (no scheme)
ARCAN_API=https://api.arcanflows.com
WORKSPACE_LABEL=Your Company   # cosmetic, shown in the header

# --- the CRM's own accounts
# Leave CRM_USERS unset and register on /register: the first account becomes the CRM admin.
# Or seed accounts (id → profile); the first one is the admin, all get CRM_SEED_PASSWORD.
# CRM_USERS='{"alice": {"name":"Alice Example","email":"alice@example.com","first_name":"Alice","last_name":"Example"}}'
# CRM_SEED_PASSWORD=changeme

# --- misc
PORT=8088
DATA_DIR=./data                # users.json + settings.json (mode 600); mount it as a volume in Docker
# CRM_CUSTOMERS='{"+15550001234": {"display_name":"Jane Perez","account":"ACME","external_ref":"CRM-4471","tier":"gold","language":"en"}}'
